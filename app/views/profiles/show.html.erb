<% content_for :title, "My Profile" %>

<section class="page-heading">
  <div>
    <h1>My profile</h1>
    <p>Review your personal information and account settings.</p>
  </div>
  <%= link_to "Edit profile", edit_profile_path, class: "primary-link" %>
</section>

<section class="card stack">
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-label">Full name</span>
      <strong><%= @person.full_name %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Email</span>
      <strong><%= @account.email %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Role</span>
      <strong><%= @person.role_label %></strong>
    </div>
    <% if @person.collaborator.present? %>
      <div class="detail-item">
        <span class="detail-label">Collaborator roles</span>
        <strong><%= @person.collaborator.role_titles.presence&.join(", ") || "No roles assigned" %></strong>
      </div>
    <% end %>
    <div class="detail-item">
      <span class="detail-label">Birth date</span>
      <strong><%= @person.birth_date.present? ? l(@person.birth_date) : "Not provided" %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Phone number</span>
      <strong><%= @person.phone_number.presence || "Not provided" %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Address</span>
      <strong><%= [@person.street, @person.street_number].compact.join(" ").presence || "Not provided" %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Postal code and city</span>
      <strong><%= [@person.postal_code, @person.city].compact.join(" ").presence || "Not provided" %></strong>
    </div>
  </div>
</section>

<% if @person.collaborator.present? %>
  <section class="card">
    <div class="page-heading">
      <div>
        <h2>My schedule</h2>
        <p>Open the month view of your lectures.</p>
      </div>
      <%= link_to "Open my schedule", schedule_path, class: "primary-link" %>
    </div>
  </section>
<% end %>

<% if @person.student.present? %>
  <section class="card">
    <div class="page-heading">
      <div>
        <h2>My grades</h2>
        <p>Grades recorded for your units.</p>
      </div>
    </div>

    <% if @student_grades.any? %>
      <table class="people-table">
        <thead>
          <tr>
            <th>Unit</th>
            <th>Awarded on</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <% @student_grades.each do |grade| %>
            <tr>
              <td><%= grade.unit.name %></td>
              <td><%= l(grade.awarded_on) %></td>
              <td><strong><%= grade.value %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No grades have been recorded yet.</p>
    <% end %>
  </section>
<% end %>
