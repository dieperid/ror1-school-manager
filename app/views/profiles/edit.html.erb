<% content_for :title, "Edit Profile" %>

<section class="page-heading">
  <div>
    <h1>Edit profile</h1>
    <p>You can update your personal information here. Current password is required to change your email or password.</p>
  </div>
  <div class="form-actions">
    <%= link_to "View profile", profile_path %>
    <%= link_to "Forgot password?", new_account_password_path %>
  </div>
</section>

<section class="card">
  <%= render "accounts/shared/error_messages", resource: @person %>

  <%= form_with url: profile_path, method: :patch do |form| %>
    <fieldset class="account-fieldset">
      <legend>Personal information</legend>

      <div class="form-grid">
        <div>
          <%= form.label :first_name, "First name" %>
          <%= form.text_field :first_name, name: "person[first_name]", value: @person.first_name, required: true %>
        </div>

        <div>
          <%= form.label :last_name, "Last name" %>
          <%= form.text_field :last_name, name: "person[last_name]", value: @person.last_name, required: true %>
        </div>

        <div>
          <%= form.label :birth_date, "Birth date" %>
          <%= form.date_field :birth_date, name: "person[birth_date]", value: @person.birth_date %>
        </div>

        <div>
          <%= form.label :phone_number, "Phone number" %>
          <%= form.telephone_field :phone_number, name: "person[phone_number]", value: @person.phone_number %>
        </div>

        <div>
          <%= form.label :street, "Street" %>
          <%= form.text_field :street, name: "person[street]", value: @person.street %>
        </div>

        <div>
          <%= form.label :street_number, "Street number" %>
          <%= form.number_field :street_number, name: "person[street_number]", value: @person.street_number, min: 1 %>
        </div>

        <div>
          <%= form.label :postal_code, "Postal code" %>
          <%= form.text_field :postal_code, name: "person[postal_code]", value: @person.postal_code %>
        </div>

        <div>
          <%= form.label :city, "City" %>
          <%= form.text_field :city, name: "person[city]", value: @person.city %>
        </div>
      </div>
    </fieldset>

    <fieldset class="account-fieldset">
      <legend>Account</legend>

      <div class="form-grid">
        <div>
          <%= form.label :email, "Email" %>
          <%= form.email_field :email, name: "account[email]", value: @account.email, required: true, autocomplete: "email" %>
        </div>

        <div>
          <%= form.label :current_password, "Current password" %>
          <%= form.password_field :current_password, name: "account[current_password]", autocomplete: "current-password" %>
        </div>

        <div>
          <%= form.label :password, "New password" %>
          <%= form.password_field :password, name: "account[password]", autocomplete: "new-password" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm new password" %>
          <%= form.password_field :password_confirmation, name: "account[password_confirmation]", autocomplete: "new-password" %>
        </div>
      </div>

      <p class="form-hint">Leave the password fields blank if you only want to update your personal information.</p>
    </fieldset>

    <div class="form-actions">
      <%= form.submit "Save profile", class: "primary-button" %>
    </div>
  <% end %>
</section>
