<% invitation = @resource.invited_at.present? && @resource.sign_in_count.zero? %>

<p>Hello <%= @resource.person.full_name %>!</p>

<% if invitation %>
  <p>An administrator created an account for you. Use the link below to choose your password and activate access.</p>
  <p><%= link_to "Set my password", edit_password_url(@resource, reset_password_token: @token) %></p>
  <p>If you were not expecting this invitation, you can ignore this email.</p>
<% else %>
  <p>Someone has requested a link to change your password. You can do this through the link below.</p>
  <p><%= link_to "Change my password", edit_password_url(@resource, reset_password_token: @token) %></p>
  <p>If you didn't request this, please ignore this email.</p>
<% end %>

<p>Your password will not change until you use the link above and choose a new one.</p>
