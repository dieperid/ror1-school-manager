<% content_for :title, "Grade" %>

<section class="page-heading">
  <div>
    <h1>Grade</h1>
    <p>Review the recorded grade for this student and unit.</p>
  </div>
  <div class="form-actions">
    <%= link_to "Edit grade", edit_unit_grade_path_for_current_account(@unit, @grade), class: "primary-link" %>
    <%= link_to "Back to unit", unit_path_for_current_account(@unit) %>
  </div>
</section>

<section class="card stack">
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-label">Student</span>
      <strong><%= current_account.admin? ? link_to(@grade.student_name, admin_person_path(@grade.student.person)) : @grade.student_name %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Unit</span>
      <strong><%= link_to @grade.unit.name, unit_path_for_current_account(@grade.unit) %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Awarded on</span>
      <strong><%= l(@grade.awarded_on) %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Value</span>
      <strong><%= @grade.value %></strong>
    </div>
  </div>

  <div class="form-actions">
    <%= button_to "Delete grade",
                  unit_grade_path_for_current_account(@unit, @grade),
                  method: :delete,
                  class: "secondary-button",
                  data: { turbo_confirm: "Delete this grade?" } %>
  </div>
</section>
