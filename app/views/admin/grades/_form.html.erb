<%= render "accounts/shared/error_messages", resource: grade %>

<%= form_with model: [:admin, grade] do |form| %>
  <div class="form-grid">
    <div>
      <%= form.label :student_id, "Student" %>
      <%= form.collection_select :student_id, students, :id, :full_name, {}, { required: true } %>
    </div>

    <div>
      <%= form.label :unit_id, "Unit" %>
      <%= form.collection_select :unit_id, units, :id, :name, {}, { required: true } %>
    </div>

    <div>
      <%= form.label :awarded_on %>
      <%= form.date_field :awarded_on, required: true %>
    </div>

    <div>
      <%= form.label :value %>
      <%= form.number_field :value, step: 0.1, min: 0, required: true %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit submit_label, class: "primary-button" %>
  </div>
<% end %>
