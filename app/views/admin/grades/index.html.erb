<% content_for :title, "Grades" %>

<section class="page-heading">
  <div>
    <h1>Grades</h1>
    <p>Manage grades awarded to students for specific units.</p>
  </div>
  <%= link_to "New grade", new_admin_grade_path, class: "primary-link" %>
</section>

<% if @grades.any? %>
  <div class="card">
    <table class="people-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Unit</th>
          <th>Awarded on</th>
          <th>Value</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @grades.each do |grade| %>
          <tr>
            <td><%= grade.student_name %></td>
            <td><%= grade.unit.name %></td>
            <td><%= l(grade.awarded_on) %></td>
            <td><strong><%= grade.value %></strong></td>
            <td>
              <div><%= link_to "View", admin_grade_path(grade) %></div>
              <div><%= link_to "Edit", edit_admin_grade_path(grade) %></div>
              <div>
                <%= button_to "Delete",
                              admin_grade_path(grade),
                              method: :delete,
                              class: "secondary-button",
                              data: { turbo_confirm: "Delete this grade?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <section class="card">
    <h2>No grades yet</h2>
    <p>Create a student and a unit first, then record the first grade.</p>
  </section>
<% end %>
