<% content_for :title, "New Grade" %>

<section class="page-heading">
  <div>
    <h1>New grade</h1>
    <p>Record a grade for a student in <%= @unit.name %>.</p>
  </div>
  <%= link_to "Back to unit", unit_path_for_current_account(@unit) %>
</section>

<section class="card">
  <%= render "form", grade: @grade, unit: @unit, students: @students, submit_label: "Create grade" %>
</section>
