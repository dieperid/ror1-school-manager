<%= render "accounts/shared/error_messages" , resource: collaborator_role %>

  <%= form_with model: [:admin, collaborator_role] do |form| %>
    <div class="form-grid">
      <div>
        <%= form.label :title %>
          <%= form.text_field :title, required: true, autofocus: true %>
      </div>
    </div>

    <div class="form-actions">
      <%= form.submit submit_label, class: "primary-button" %>
    </div>
    <% end %>