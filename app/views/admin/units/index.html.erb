<% content_for :title, "Units" %>

<section class="page-heading">
  <div>
    <h1>Units</h1>
    <p>Manage units and review the modules that use them.</p>
  </div>
  <%= link_to "New unit", new_admin_unit_path, class: "primary-link" %>
</section>

<% if @units.any? %>
  <div class="card">
    <table class="people-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Modules</th>
          <th>Lectures</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @units.each do |unit| %>
          <tr>
            <td><strong><%= unit.name %></strong></td>
            <td><%= unit.learning_modules.map(&:name).presence&.join(", ") || "None" %></td>
            <td><%= pluralize(unit.lecture_count, "lecture") %></td>
            <td>
              <div><%= link_to "View", admin_unit_path(unit) %></div>
              <div><%= link_to "Edit", edit_admin_unit_path(unit) %></div>
              <div>
                <%= button_to "Delete",
                              admin_unit_path(unit),
                              method: :delete,
                              class: "secondary-button",
                              data: { turbo_confirm: "Delete #{unit.name}?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <section class="card">
    <h2>No units yet</h2>
    <p>Create units first so you can attach them to learning modules.</p>
  </section>
<% end %>
