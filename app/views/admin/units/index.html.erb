<% content_for :title, "Units" %>

<section class="page-heading">
  <div>
    <h1>Units</h1>
    <p><%= current_admin_or_dean? ? "Manage units and review the modules that use them." : "Review the units you teach and manage their grades." %></p>
  </div>
  <% if current_admin_or_dean? %>
    <%= link_to "New unit", new_admin_unit_path, class: "primary-link" %>
  <% end %>
</section>

<% if @units.any? %>
  <div class="card">
    <table class="people-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Modules</th>
          <th>Lectures</th>
          <th>Grades</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @units.each do |unit| %>
          <tr>
            <td><strong><%= unit.name %></strong></td>
            <td><%= unit.learning_modules.map(&:name).presence&.join(", ") || "None" %></td>
            <td><%= pluralize(@lecture_counts.fetch(unit.id, 0), "lecture") %></td>
            <td><%= pluralize(@grade_counts.fetch(unit.id, 0), "grade") %></td>
            <td>
              <div><%= link_to "View", unit_path_for_current_account(unit) %></div>
              <% if current_admin_or_dean? %>
                <div><%= link_to "Edit", edit_admin_unit_path(unit) %></div>
                <div>
                  <%= button_to "Delete",
                                admin_unit_path(unit),
                                method: :delete,
                                class: "secondary-button",
                                data: { turbo_confirm: "Delete #{unit.name}?" } %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render "shared/pagination", pagination: @pagination %>
  </div>
<% else %>
  <section class="card">
    <h2>No units yet</h2>
    <p><%= current_admin_or_dean? ? "Create units first so you can attach them to learning modules." : "No units are assigned to your lectures yet." %></p>
  </section>
<% end %>
