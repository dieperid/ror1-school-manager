<% content_for :title, @unit.name %>

<section class="page-heading">
  <div>
    <h1><%= @unit.name %></h1>
    <p>Review the unit and the learning modules linked to it.</p>
  </div>
  <div class="form-actions">
    <% if current_account.admin? %>
      <%= link_to "Edit unit", edit_admin_unit_path(@unit), class: "primary-link" %>
    <% end %>
    <%= link_to "Back to units", admin_units_path %>
  </div>
</section>

<section class="card stack">
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-label">Name</span>
      <strong><%= @unit.name %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Learning modules</span>
      <strong><%= @learning_modules.map(&:name).presence&.join(", ") || "None" %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Lectures</span>
      <strong><%= pluralize(@lectures.size, "lecture") %></strong>
    </div>
    <div class="detail-item">
      <span class="detail-label">Grades</span>
      <strong><%= pluralize(@grades.size, "grade") %></strong>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "New grade", new_admin_unit_grade_path(@unit), class: "primary-link" %>
    <% if current_account.admin? %>
      <%= link_to "New lecture", new_admin_lecture_path(unit_id: @unit.id), class: "primary-link" %>
      <%= button_to "Delete unit",
                    admin_unit_path(@unit),
                    method: :delete,
                    class: "secondary-button",
                    data: { turbo_confirm: "Delete #{@unit.name}?" } %>
    <% end %>
  </div>
</section>

<section class="card">
  <div class="page-heading">
    <div>
      <h2>Grades</h2>
      <p>Grades currently linked to this unit.</p>
    </div>
  </div>

  <% if @grades.any? %>
    <table class="people-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Awarded on</th>
          <th>Value</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @grades.each do |grade| %>
          <tr>
            <td><%= grade.student_name %></td>
            <td><%= l(grade.awarded_on) %></td>
            <td><strong><%= grade.value %></strong></td>
            <td>
              <div><%= link_to "View", admin_unit_grade_path(@unit, grade) %></div>
              <div><%= link_to "Edit", edit_admin_unit_grade_path(@unit, grade) %></div>
              <div>
                <%= button_to "Delete",
                              admin_unit_grade_path(@unit, grade),
                              method: :delete,
                              class: "secondary-button",
                              data: { turbo_confirm: "Delete this grade?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No grades are linked to this unit yet.</p>
  <% end %>
</section>

<section class="card">
  <div class="page-heading">
    <div>
      <h2>Lectures</h2>
      <p>Lectures currently linked to this unit.</p>
    </div>
  </div>

  <% if @lectures.any? %>
    <table class="people-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Time</th>
          <th>Room</th>
          <th>Collaborator</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @lectures.each do |lecture| %>
          <tr>
            <td><%= l(lecture.date) %></td>
            <td><%= "#{lecture.start_time.strftime('%H:%M')} - #{lecture.end_time.strftime('%H:%M')}" %></td>
            <td><%= lecture.room.name %></td>
            <td><%= lecture.collaborator.full_name %></td>
            <td><%= current_account.admin? ? link_to("View", admin_lecture_path(lecture)) : "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No lectures are linked to this unit yet.</p>
  <% end %>
</section>

<section class="card">
  <div class="page-heading">
    <div>
      <h2>Linked learning modules</h2>
      <p>Modules currently using this unit.</p>
    </div>
  </div>

  <% if @learning_modules.any? %>
    <table class="people-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @learning_modules.each do |learning_module| %>
          <tr>
            <td><strong><%= learning_module.name %></strong></td>
            <td><%= current_account.admin? ? link_to("View", admin_learning_module_path(learning_module)) : "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No learning modules are linked to this unit yet.</p>
  <% end %>
</section>
