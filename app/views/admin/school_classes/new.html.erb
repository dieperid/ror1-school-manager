<% content_for :title, "New School Class" %>

<section class="page-heading">
  <div>
    <h1>New school class</h1>
    <p>Create a class and assign its formation plan and responsible collaborator.</p>
  </div>
  <%= link_to "Back to school classes", admin_school_classes_path %>
</section>

<section class="card">
  <%= render "form",
             school_class: @school_class,
             formation_plans: @formation_plans,
             responsible_collaborators: @responsible_collaborators,
             submit_label: "Create school class" %>
</section>
