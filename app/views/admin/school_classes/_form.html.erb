<%= render "accounts/shared/error_messages", resource: school_class %>

<%= form_with model: [:admin, school_class] do |form| %>
  <div class="form-grid">
    <div>
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
    </div>

    <div>
      <%= form.label :formation_plan_id, "Formation plan" %>
      <%= form.collection_select :formation_plan_id, formation_plans, :id, :name, {}, { required: true } %>
    </div>

    <div>
      <%= form.label :responsible_collaborator_id, "Responsible collaborator" %>
      <%= form.collection_select :responsible_collaborator_id,
                                 responsible_collaborators,
                                 :id,
                                 :display_name,
                                 {},
                                 { required: true } %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit submit_label, class: "primary-button" %>
  </div>
<% end %>
