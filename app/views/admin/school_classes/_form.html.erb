<%= render "accounts/shared/error_messages", resource: school_class %>

<%= form_with model: [:admin, school_class] do |form| %>
  <div class="form-grid">
    <div>
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
    </div>

    <div>
      <%= form.label :formation_plan_id, "Formation plan" %>
      <%= form.collection_select :formation_plan_id, formation_plans, :id, :name, {}, { required: true } %>
    </div>

    <div>
      <%= form.label :responsible_collaborator_id, "Responsible collaborator" %>
      <%= form.collection_select :responsible_collaborator_id,
                                 responsible_collaborators,
                                 :id,
                                 :display_name,
                                 {},
                                 { required: true } %>
    </div>
  </div>

  <fieldset class="account-fieldset">
    <legend>Student enrollments</legend>

    <% if students.any? %>
      <div class="form-grid">
        <%= hidden_field_tag "school_class[student_ids][]", "", id: nil %>

        <% students.each do |student| %>
          <div class="checkbox-row">
            <%= check_box_tag "school_class[student_ids][]",
                              student.id,
                              selected_student_ids.include?(student.id),
                              id: "school_class_student_#{student.id}" %>
            <%= label_tag "school_class_student_#{student.id}", student.full_name %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p>No students exist yet. You can create the class now and enroll students later.</p>
    <% end %>

    <p class="form-hint">Students belong to a class through the enrollment table, so this selection manages the class enrollments.</p>
  </fieldset>

  <div class="form-actions">
    <%= form.submit submit_label, class: "primary-button" %>
  </div>
<% end %>
