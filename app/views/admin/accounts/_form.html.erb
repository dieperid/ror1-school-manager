<%= render "accounts/shared/error_messages", resource: account %>

<%= form_with model: [:admin, person, account], data: { turbo: false } do |form| %>
  <div class="form-grid">
    <div>
      <%= form.label :email %>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </div>

    <div class="checkbox-row">
      <%= form.check_box :enabled %>
      <%= form.label :enabled, "Account enabled" %>
    </div>

    <div class="checkbox-row">
      <%= form.check_box :admin %>
      <%= form.label :admin, "Grant admin access" %>
    </div>
  </div>

  <% if show_password_fields %>
    <fieldset class="account-fieldset">
      <legend>Optional password reset by admin</legend>
      <div class="form-grid">
        <div>
          <%= form.label :password %>
          <%= form.password_field :password, autocomplete: "new-password" %>
        </div>

        <div>
          <%= form.label :password_confirmation %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>
      </div>
      <p class="form-hint">Leave the password fields blank to keep the current password unchanged.</p>
    </fieldset>
  <% else %>
    <p class="form-hint">After creation, the app will download a text file with the username and password setup link.</p>
  <% end %>

  <div class="form-actions">
    <%= form.submit submit_label, class: "primary-button" %>
  </div>
<% end %>
