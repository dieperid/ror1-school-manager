<% content_for :title, "Edit Person" %>

<section class="page-heading">
  <div>
    <h1>Edit person</h1>
    <p>Update the personal information linked to this record.</p>
  </div>
  <div class="form-actions">
    <%= link_to "View person", admin_person_path(@person) %>
    <%= link_to "Back to people", admin_people_path %>
  </div>
</section>

<section class="card">
  <%= render "form",
             person: @person,
             show_account_fields: false,
             account_email: nil,
             account_admin: false,
             submit_label: "Save changes" %>
</section>
