<% content_for :title, "People" %>

<section class="page-heading">
  <div>
    <h1>People</h1>
    <p>Create, review, update, and remove people and their linked accounts.</p>
  </div>
  <%= link_to "New person", new_admin_person_path, class: "primary-link" %>
</section>

<section class="card">
  <%= form_with url: admin_people_path, method: :get, local: true do |form| %>
    <div class="form-grid">
      <div>
        <%= form.label :role, "Filter by role" %>
        <%= form.select :role,
                        options_for_select(@role_filter_options, @role_filter),
                        {},
                        { onchange: "this.form.requestSubmit()" } %>
      </div>
    </div>

    <div class="form-actions">
      <% if @role_filter != "all" %>
        <%= link_to "Clear", admin_people_path, class: "secondary-button" %>
      <% end %>
    </div>
  <% end %>
</section>

<% if @people.any? %>
  <div class="card">
    <table class="people-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th>AVS</th>
          <th>Contact</th>
          <th>Account</th>
          <th>Invite</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @people.each do |person| %>
          <% account = person.account %>
          <tr>
            <td><strong><%= person.full_name %></strong></td>
            <td>
              <div><%= person.role_label %></div>
              <% if person.collaborator.present? && person.collaborator.role_titles.any? %>
                <div><%= person.collaborator.role_titles.join(", ") %></div>
              <% end %>
            </td>
            <td><%= person.avs_number %></td>
            <td>
              <div><%= [person.street, person.street_number].compact.join(" ") %></div>
              <div><%= [person.postal_code, person.city].compact.join(" ") %></div>
              <div><%= person.phone_number.presence || "No phone number" %></div>
            </td>
            <td>
              <% if account.present? %>
                <div><%= account.email %></div>
                <div><%= "#{account.access_label} account" %></div>
                <div><%= account.enabled? ? "Enabled" : "Disabled" %></div>
              <% else %>
                <div>No account linked</div>
              <% end %>
            </td>
            <td>
              <% if account.present? %>
                <% if account.invited_at.present? %>
                  <div>Last generated: <%= l(account.invited_at, format: :long) %></div>
                <% else %>
                  <div>Not generated yet</div>
                <% end %>
                <div><%= link_to "Download invite (.txt)", admin_person_account_invitation_path(person, format: :txt) %></div>
              <% else %>
                No invite
              <% end %>
            </td>
            <td>
              <div><%= link_to "View", admin_person_path(person) %></div>
              <div><%= link_to "Edit", edit_admin_person_path(person) %></div>
              <% if person != current_person && !(current_dean? && account&.admin?) %>
                <div>
                  <%= button_to "Delete",
                                admin_person_path(person),
                                method: :delete,
                                class: "secondary-button",
                                data: { turbo_confirm: "Delete #{person.full_name}?" } %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render "shared/pagination", pagination: @pagination %>
  </div>
<% else %>
  <section class="card">
    <h2>No people yet</h2>
    <p><%= @role_filter == "all" ? "Create the first person and optionally generate the account invitation file in the same action." : "No people match the selected role filter." %></p>
  </section>
<% end %>
