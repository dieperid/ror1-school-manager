<% content_for :title, "Dashboard" %>

<% if current_account.admin? %>
  <section class="card">
    <h1>Admin dashboard</h1>
    <p>Create people, attach accounts to them, and send invitation emails.</p>
    <p><%= link_to "Manage people", admin_people_path, class: "primary-link" %></p>
  </section>
<% else %>
  <section class="card">
    <h1>Account active</h1>
    <p>Your account is available. Additional features can be assigned by an administrator.</p>
  </section>
<% end %>
